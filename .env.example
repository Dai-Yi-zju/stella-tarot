# 复制本文件为 .env 并在 .env 里填入你的 Key（不要把真实 Key 写在本文件里，本文件会被提交到 git）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 使用的 GPT 模型
OPENAI_MODEL=gpt-5
# 网页版的推理强度：minimal（最快）/ low（默认）/ medium / high / default（不设置）
# OPENAI_REASONING_EFFORT=low
# 如果使用代理 / 中转服务，取消下一行注释并填写 base url
# OPENAI_BASE_URL=https://api.openai.com/v1
